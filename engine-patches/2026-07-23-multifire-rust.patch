+    /// Whether this policy can surface *multiple* candidate trigger windows for
+    /// cooldown-based multi-fire (static course-geometry windows the vacuum sim
+    /// knows exactly). Only corner-random / straight-random qualify.
+    pub fn is_multi_fire_policy(&self) -> bool {
+        matches!(
+            self,
+            ActivationSamplePolicy::AllCornerRandom | ActivationSamplePolicy::StraightRandom
+        )
+    }
+
+    /// Sample, per draw, the **full set** of candidate trigger windows for a
+    /// multi-fire (short-cooldown corner/straight) skill — one `Vec<Region>` per
+    /// of `nsamples` draws. Only [`AllCornerRandom`](Self::AllCornerRandom) and
+    /// [`StraightRandom`](Self::StraightRandom) produce sets; every other policy
+    /// returns an empty outer vector (they are never multi-fire eligible). The
+    /// runner emits one pending trigger per window in the chosen set, and the
+    /// distance-scaled cooldown gate decides which actually fire.
+    pub fn sample_multi(
+        &self,
+        regions: &RegionList,
+        nsamples: usize,
+        rng: &mut dyn Prng,
+    ) -> Vec<Vec<Region>> {
+        match self {
+            ActivationSamplePolicy::AllCornerRandom => (0..nsamples)
+                .map(|_| {
+                    Self::place_trigger_positions(regions, rng)
+                        .into_iter()
+                        .map(|p| Region::new(p, p + 10.0))
+                        .collect()
+                })
+                .collect(),
+            ActivationSamplePolicy::StraightRandom => (0..nsamples)
+                .map(|_| Self::sample_straight_multi(regions, rng))
+                .collect(),
+            _ => Vec::new(),
+        }
+    }
+
+    /// Multi-window straight sampling: pick a random first straight, then place
