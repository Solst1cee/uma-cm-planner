+    /// Mirrors `StraightRandomPolicy::sampleMulti`.
+    fn sample_straight_multi(regions: &RegionList, rng: &mut dyn Prng) -> Vec<Region> {
+        if regions.0.is_empty() {
+            return Vec::new();
+        }
+        let mut sorted = regions.0.clone();
+        sorted.sort_by(|a, b| a.start.total_cmp(&b.start));
+        let start_idx = rng.uniform(sorted.len() as u32) as usize;
+        sorted[start_idx..]
+            .iter()
+            .map(|region| {
+                let span = (region.len() - 10.0).max(0.0);
+                let pos = region.start + f64::from(rng.uniform(span as u32));
+                Region::new(pos, pos + 10.0)
+            })
+            .collect()
+    }
